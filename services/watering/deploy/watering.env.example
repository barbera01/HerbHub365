# Example non-secret runtime config for HerbHub watering service.
# Copy to /etc/default/watering and adjust as needed.

# Leave unset to run HTTP API only (RabbitMQ consumer disabled).
# RABBITMQ_URL=amqp://user:password@rabbitmq:5672/

# Optional queue override.
RABBITMQ_QUEUE=watering.queue

# Safety contract for action=water:
# - requires AMQP message_id
# - requires AMQP timestamp within 5 minutes (allows up to 1 minute future skew)
# Deliveries outside this contract are rejected without GPIO actuation.

# Optional durable dedupe ledger path for RabbitMQ water message_id suppression.
# Must be writable by the service user. The installer unit sets StateDirectory=herbhub-watering,
# so this default path is safe with ProtectSystem=strict.
# WATERING_DEDUPE_FILE=/var/lib/herbhub-watering/completed.json
